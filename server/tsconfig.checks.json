{
  // The check suites live in prisma/ and are excluded from the main tsconfig
  // (rootDir is ./src, include is src/**/*.ts). That meant a type error in a
  // check script passed `npm run build` silently and only appeared when the
  // script was run -- a duplicate const declaration did exactly that, and the
  // build was green while the check could not execute.
  //
  // These scripts are what proves the system behaves, so a type error in one
  // should fail fast rather than at test time.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["prisma/**/*.ts", "src/**/*.ts"],
  // checkRadialLayout.ts exercises the client-side chart layout, so it imports
  // across into client/. That is outside this tsconfig's rootDir and its "@/"
  // alias points at server/src, so including it fails on module resolution
  // rather than on anything real.
  //
  // The layout is still typechecked -- by the client build, which compiles
  // OrgGraph.tsx and therefore everything it pulls in. This file only has to
  // prove the geometry behaves.
  "exclude": ["prisma/checkRadialLayout.ts"]
}