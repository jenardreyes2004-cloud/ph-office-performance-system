NODE_ENV=development
PORT=4000
# Replace 'password' with the postgres superuser password you set during install,
# and 'office_perf' with the database name if you named it differently.
DATABASE_URL=postgresql://postgres:password@localhost:5432/office_perf?schema=public
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
