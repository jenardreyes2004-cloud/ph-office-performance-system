generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  MAIN_ADMIN
  OFFICE_ADMIN
  IT_ADMIN
  EMPLOYEE
}

enum PlanStatus {
  DRAFT
  ACTIVE
  ONGOING
  COMPLETED
  DELAYED
  ARCHIVED
}

enum AssignmentStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  DELAYED
  CANCELLED
}

enum ReportType {
  OFFICE_SUMMARY
  PLAN_PROGRESS
  EMPLOYEE_PERFORMANCE
  CUSTOM
}

enum MonthlyUpdateStatus {
  ON_TIME
  LATE
  MISSING
}

enum NotificationType {
  PLAN_ASSIGNED
  UPDATE_OVERDUE
  UPDATE_REMINDER_SENT
  REPORT_FLAGGED
  METRIC_UPDATED
  PERFORMANCE_RECORDED
}

// New: office-level Balanced Scorecard (PhilHealth SPMS format)
enum ScorecardPerspective {
  DELIGHTED_CLIENTS
  EXCELLENT_PROCESS
  SUSTAINABLE_FUND
  STRONG_FOUNDATION
}

enum ScorecardGrade {
  OUTSTANDING
  VERY_SATISFACTORY
  SATISFACTORY
  UNSATISFACTORY
  POOR
}

enum OfficeScorecardStatus {
  DRAFT
  FINALIZED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(EMPLOYEE)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee  Employee?
  records   PerformanceRecord[] @relation("RecordedBy")
  reports   Report[]            @relation("GeneratedBy")
  auditLogs AuditLog[]

  // New: who added which employees, who assigned which plan assignments
  employeesAdded          Employee[]       @relation("EmployeeAddedBy")
  assignmentsMade         PlanAssignment[] @relation("AssignmentAssignedBy")
  monthlyUpdatesSubmitted MonthlyUpdate[]  @relation("MonthlyUpdateSubmittedBy")

  notificationsReceived Notification[] @relation("ReceivedNotifications")
  notificationsSent     Notification[] @relation("SentNotifications")

  officeScorecardsFinalized OfficeScorecard[] @relation("ScorecardFinalizedBy")

  @@map("users")
}

model Office {
  id          String    @id @default(uuid())
  name        String
  code        String    @unique
  description String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  employees        Employee[]
  planOffices      PlanOffice[]
  reports          Report[]
  monthlyUpdates   MonthlyUpdate[]
  officeScorecards OfficeScorecard[]

  @@map("offices")
}

model Employee {
  id        String    @id @default(uuid())
  userId    String?   @unique
  officeId  String
  firstName String
  lastName  String
  position  String?
  hiredAt   DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // New: which Office Admin/User added this employee to the roster
  addedByUserId String?
  addedBy       User?   @relation("EmployeeAddedBy", fields: [addedByUserId], references: [id])

  user               User?               @relation(fields: [userId], references: [id])
  office             Office              @relation(fields: [officeId], references: [id])
  planAssignments    PlanAssignment[]
  performanceRecords PerformanceRecord[]

  @@index([officeId])
  @@map("employees")
}

model Plan {
  id          String     @id @default(uuid())
  title       String
  description String?
  periodStart DateTime
  periodEnd   DateTime
  status      PlanStatus @default(DRAFT)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  planOffices        PlanOffice[]
  planAssignments    PlanAssignment[]
  performanceRecords PerformanceRecord[]
  reports            Report[]
  monthlyUpdates     MonthlyUpdate[]

  @@map("plans")
}

model PlanOffice {
  id       String  @id @default(uuid())
  planId   String
  officeId String
  target   String?

  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)

  @@unique([planId, officeId])
  @@map("plan_offices")
}

model PlanAssignment {
  id             String           @id @default(uuid())
  planId         String
  employeeId     String
  responsibility String?
  dueDate        DateTime?
  status         AssignmentStatus @default(NOT_STARTED)
  progressPct    Decimal          @default(0) @db.Decimal(5, 2)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // New: which user (Office Admin) made this assignment
  assignedByUserId String?
  assignedBy       User?   @relation("AssignmentAssignedBy", fields: [assignedByUserId], references: [id])

  plan     Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([planId, employeeId])
  @@map("plan_assignments")
}

model PerformanceMetric {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  unit        String?
  weightPct   Decimal   @default(0) @db.Decimal(5, 2)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  records PerformanceRecord[]

  @@map("performance_metrics")
}

model PerformanceRecord {
  id           String   @id @default(uuid())
  employeeId   String
  metricId     String
  planId       String?
  recordedById String
  score        Float
  periodStart  DateTime
  periodEnd    DateTime
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee   Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  metric     PerformanceMetric @relation(fields: [metricId], references: [id])
  plan       Plan?             @relation(fields: [planId], references: [id])
  recordedBy User              @relation("RecordedBy", fields: [recordedById], references: [id])

  @@index([employeeId])
  @@index([metricId])
  @@map("performance_records")
}

model Report {
  id            String     @id @default(uuid())
  title         String
  type          ReportType @default(CUSTOM)
  generatedById String
  planId        String?
  officeId      String?
  content       Json?
  createdAt     DateTime   @default(now())

  generatedBy User    @relation("GeneratedBy", fields: [generatedById], references: [id])
  plan        Plan?   @relation(fields: [planId], references: [id])
  office      Office? @relation(fields: [officeId], references: [id])

  @@map("reports")
}

// New: periodic office/plan progress updates (monthly cadence)
model MonthlyUpdate {
  id                String              @id @default(uuid())
  officeId          String
  planId            String?
  submittedByUserId String
  monthStartDate    DateTime
  monthEndDate      DateTime
  content           String
  status            MonthlyUpdateStatus @default(ON_TIME)
  submittedAt       DateTime?
  createdAt         DateTime            @default(now())

  office      Office @relation(fields: [officeId], references: [id])
  plan        Plan?  @relation(fields: [planId], references: [id])
  submittedBy User   @relation("MonthlyUpdateSubmittedBy", fields: [submittedByUserId], references: [id])

  @@index([officeId])
  @@map("monthly_updates")
}

// New: in-app notifications (e.g. admin pings a delayed office)
model Notification {
  id              String           @id @default(uuid())
  recipientId     String
  senderId        String?
  type            NotificationType
  message         String
  relatedOfficeId String?
  relatedPlanId   String?
  relatedReportId String?
  isRead          Boolean          @default(false)
  createdAt       DateTime         @default(now())

  recipient User  @relation("ReceivedNotifications", fields: [recipientId], references: [id])
  sender    User? @relation("SentNotifications", fields: [senderId], references: [id])

  @@index([recipientId])
  @@map("notifications")
}

// New: annual (or custom) cycle a scorecard is filled out for, e.g. "CY 2025"
model ScorecardPeriod {
  id        String   @id @default(uuid())
  label     String // "January 2025 to December 2025"
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  officeScorecards OfficeScorecard[]

  @@map("scorecard_periods")
}

// New: one scorecard "document" per office per period — this is the printable report
model OfficeScorecard {
  id       String                 @id @default(uuid())
  officeId String
  periodId String
  status   OfficeScorecardStatus  @default(DRAFT)

  // Sign-off block (mirrors the bottom of the printed form)
  raterName                     String?
  raterTitle                    String?
  nextHigherSupervisorName      String?
  nextHigherSupervisorTitle     String?

  // Rollup snapshot, computed at finalize time (see scorecard.service.ts)
  totalWeight  Decimal?        @db.Decimal(6, 2)
  totalScore   Decimal?        @db.Decimal(6, 2)
  officeRating ScorecardGrade?
  finalizedAt  DateTime?

  finalizedByUserId String?
  finalizedBy       User?   @relation("ScorecardFinalizedBy", fields: [finalizedByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  office  Office          @relation(fields: [officeId], references: [id], onDelete: Cascade)
  period  ScorecardPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  entries ScorecardEntry[]

  @@unique([officeId, periodId])
  @@index([periodId])
  @@map("office_scorecards")
}

// New: one KPI line item on a scorecard ("Strategic Objective" row)
model ScorecardEntry {
  id                 String               @id @default(uuid())
  officeScorecardId  String
  perspective        ScorecardPerspective
  sortOrder          Int                  @default(0)
  strategicObjective String
  responsibleUnit    String?
  measure            String
  performanceTarget  String
  weightPct          Decimal              @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  officeScorecard OfficeScorecard  @relation(fields: [officeScorecardId], references: [id], onDelete: Cascade)
  bands           ScorecardBand[]
  result          ScorecardResult?

  @@index([officeScorecardId])
  @@map("scorecard_entries")
}

// New: one grading band ("Possible Scenario") for an entry, e.g. "90-100% = O"
model ScorecardBand {
  id      String         @id @default(uuid())
  entryId String
  grade   ScorecardGrade

  // Optional numeric range, used to auto-suggest a grade when the result is a clean %.
  // Left null for bands defined by dates/absolute counts instead of percentages.
  minPct Decimal? @db.Decimal(6, 2)
  maxPct Decimal? @db.Decimal(6, 2)

  // Verbatim wording from the form, always shown as-is in the report/print view.
  rawLabel String

  entry ScorecardEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@map("scorecard_bands")
}

// New: the actual accomplishment + resulting grade/score for one entry
model ScorecardResult {
  id      String @id @default(uuid())
  entryId String @unique

  rawResult    String // as reported, e.g. "36.6% (1.48M)"
  resultPct    Decimal? @db.Decimal(6, 2) // numeric % of target, if applicable
  grade        ScorecardGrade?
  isAutoGraded Boolean         @default(false)

  initialScore Decimal? @db.Decimal(6, 2)
  finalScore   Decimal? @db.Decimal(6, 2)
  notes        String?

  updatedAt DateTime @updatedAt

  entry ScorecardEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@map("scorecard_results")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@map("audit_logs")
}
